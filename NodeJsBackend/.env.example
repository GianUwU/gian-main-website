ACCESS_TOKEN_SECRET=replace_with_long_random_hex
REFRESH_TOKEN_SECRET=replace_with_long_random_hex

# Optional cookie settings for cross-subdomain auth (example for *.gian.ink)
# COOKIE_DOMAIN=.gian.ink
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true

# Authelia Single Sign-On settings
AUTHELIA_FORWARD_AUTH_URL=http://authelia:9091/api/authz/forward-auth
AUTHELIA_PORTAL_URL=https://auth.gian.ink
